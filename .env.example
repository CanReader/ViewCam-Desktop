# Template for Desktop/.env — copy this file to .env and fill in real values.
# .env is gitignored; this template is committed.
#
# Values here are read at CMake configure time. An explicit -D on the cmake
# command line always wins, which is how CI and release builds supply them.

# Anonymous usage analytics ingest.
# The project key is publishable and write-only (same trust level as a web
# analytics snippet), but it lives here rather than in CMakeLists so forks and
# local builds do not silently report into production.
# Leave the key empty to disable analytics entirely.
VIEWCAM_ANALYTICS_HOST=https://eu.i.posthog.com
VIEWCAM_ANALYTICS_KEY=
